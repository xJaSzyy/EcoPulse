{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Consul": {
    "ServiceName": "weather-service",
    "ServiceAddress": "weather-service:5000",
    "HealthCheckPath": "/health",
    "CheckInterval": "10s"
  },
  "WeatherService": {
    "FetchIntervalMinutes": 15
  },
  "AllowedHosts": "*"
}
